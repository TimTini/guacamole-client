*~
target/
.flattened-pom.xml

# Local deployment state never belongs in a public checkout.
runtime/
deploy-local/data/
deploy-local/secrets/
deploy-local/libvirt/exports/
deploy-local/libvirt/*.generated.xml

# VM disks, firmware, TPM state, installers, and other machine images.
*.vhdx
*.qcow2
*.qcow
*.vmdk
*.vdi
*.iso
*.img
*.nvram
*.fd
*.tpm
*.tpm2
*.swtpm
*.permall
*.swp
**/tpm/
**/swtpm/

# Logs, backups, archives, dumps, and generated runtime reports.
*.log
*.bak
*.backup
*.zip
*.tar
*.tar.gz
*.gz
*.bz2
*.xz
*.tgz
*.7z
*.rar
*.archive
*.dump
*.pgdump
*.sqlite
*.sqlite3
*.db
**/backup/
**/backups/
**/archive/
**/archives/
**/logs/
**/__pycache__/
**/.cache/
*.pyc
*.pyo
*.class
*.pid
*.marker
*.generated.*

# Credentials, private keys, local environment files, and generated inventory.
*.pem
*.key
*.p12
*.pfx
*.env
.env
.env.*
*.secret
*.token
*.password
*.passwd
**/*password*
**/*passwd*
**/*secret*
**/*token*
**/*credential*
**/*private-key*
**/*private_key*
**/*privatekey*
**/*passphrase*
**/*inventory*.json
**/*inventory*.csv
**/*inventory*.txt
**/*inventory*.yaml
**/*inventory*.yml
**/*inventory*.xml

# The production Windows credential lives in the WSL ext4 VHDX at
# /var/lib/guacamole-workspace/secrets, outside this checkout. Keep any
# accidental local mirror ignored as well.
deploy-local/**/windows11_guacadmin_password
